# 示例文件只保存占位值，实际密钥请填到 .env。
# 在 experiments/clarification/ 中加载：set -a; source .env; set +a
# 文本模型：智谱标准 API；请填写智谱标准 API Key，不要使用 DeepSeek Key。
CASEVO_CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CASEVO_CHAT_MODEL=glm-5.3
CASEVO_CHAT_API_KEY=111111

# Embedding 官方基础地址和模型已填写；实际 Key 已转存 .env。
# 文本请求路径：/chat/completions；向量请求路径：/embeddings。
# 代码会自动拼接请求路径，BASE_URL 不要包含以上路径。
CASEVO_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CASEVO_EMBEDDING_MODEL=embedding-3
CASEVO_EMBEDDING_API_KEY=111111

# Token 总量预算：0 表示不设上限；正整数表示总量上限。
CASEVO_MAX_TOTAL_TOKENS=0
